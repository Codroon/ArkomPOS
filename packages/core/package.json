{
  "name": "@arkom/core",
  "version": "0.1.0",
  "private": true,
  "description": "Domain: ids, money/rounding, tax snapshot, ledger rules, mutate() envelope, Zod IPC schemas. Imports nothing from apps; no React/Electron/SQL/fetch.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pin-hash": "./src/pin-hash.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
