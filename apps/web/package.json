{
  "name": "@arkom/web",
  "version": "0.1.0",
  "private": true,
  "description": "Codroon POS cloud: the ingest door (/api/enrol, /api/sync), the shop's dashboard and Codroon's admin. Read model only — no till logic here, and it never writes back to a till.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cloud:code": "node --env-file-if-exists=.env.local scripts/issue-code.mts",
    "cloud:delete-tenant": "node --env-file-if-exists=.env.local scripts/delete-tenant.mts",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@arkom/core": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.4",
    "lucide-react": "^0.462.0",
    "next": "^15.4.5",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
