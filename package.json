{
  "name": "arkom-pos",
  "private": true,
  "version": "0.10.0",
  "description": "Arkom POS — offline-first desktop till + cloud dashboard (see docs/adr, docs/design/system-design.md)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter arkom-pos dev",
    "dev:web": "pnpm --filter @arkom/web dev",
    "test": "pnpm --filter @arkom/core test && pnpm --filter arkom-pos test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @arkom/db db:generate",
    "db:migrate": "pnpm --filter arkom-pos db:migrate",
    "db:seed": "pnpm --filter arkom-pos db:seed",
    "db:stats": "pnpm --filter arkom-pos db:stats",
    "db:audit": "pnpm --filter arkom-pos db:audit",
    "imei:gen": "pnpm --filter arkom-pos imei:gen",
    "build:win": "pnpm --filter arkom-pos build:win"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
