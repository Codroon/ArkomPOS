# deps / build output
node_modules/
out/
dist/
release/
.next/

# local dev database (seeded via pnpm db:seed)
.data/
*.db
*.db-wal
*.db-shm

# runtime data — these live in userData on a real till, never in the repo, but
# a dev pointing userData at the working tree must not be able to commit a
# shop's tickets, takings or backups
backups/
tickets/
logs/

# secrets — a cloud database URL and any token pasted beside it. The till has no
# .env at all; this is the web half's, and it must never be committable.
.env
.env.local
.env*.local
.vercel/

# misc
*.log
*.tsbuildinfo
next-env.d.ts
.DS_Store

# Source doc bundles (already merged into ./docs and ./packages/db/src/schema.ts —
# safe to delete once you no longer need the originals)
arkom-pos-adr-set/
arkom-pos-design-kit/
arkom-pos-design-handoff/
arkom-pos-phase1-prd/
.archive/
